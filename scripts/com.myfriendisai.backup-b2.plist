<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.myfriendisai.backup-b2</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/walker/Projects/myfriendisai/scripts/backup_to_b2.sh</string>
    </array>

    <!-- Run daily at 14:00 local — well after the 06:00 collection finishes
         (typical 45-80 min, worst case ~5h), so it captures the day's data. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>14</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/walker/Projects/myfriendisai/logs/backup_b2.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/walker/Projects/myfriendisai/logs/backup_b2.launchd.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/walker/Projects/myfriendisai</string>
</dict>
</plist>
